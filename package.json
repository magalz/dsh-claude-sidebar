{
  "name": "dsh-claude-sidebar",
  "version": "0.1.0",
  "private": true,
  "description": "Claude-desktop-style panels for the DeepSeek Harness right sidebar: an icon rail and tabs for the open session.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./rail": "./features/rail/host.js",
    "./rail/locale/*.json": "./features/rail/locale/*.json",
    "./rail/icon": "./features/rail/icon.svg",
    "./jobs": "./features/jobs/host.js",
    "./jobs/locale/*.json": "./features/jobs/locale/*.json",
    "./jobs/icon": "./features/jobs/icon.svg",
    "./subagents": "./features/subagents/host.js",
    "./subagents/locale/*.json": "./features/subagents/locale/*.json",
    "./subagents/icon": "./features/subagents/icon.svg",
    "./environment": "./features/environment/host.js",
    "./environment/locale/*.json": "./features/environment/locale/*.json",
    "./environment/icon": "./features/environment/icon.svg",
    "./run": "./features/run/host.js",
    "./run/locale/*.json": "./features/run/locale/*.json",
    "./run/icon": "./features/run/icon.svg",
    "./git": "./features/git/host.js",
    "./git/locale/*.json": "./features/git/locale/*.json",
    "./git/icon": "./features/git/icon.svg",
    "./sizing": "./features/sizing/host.js",
    "./sizing/locale/*.json": "./features/sizing/locale/*.json",
    "./sizing/icon": "./features/sizing/icon.svg",
    "./browser": "./features/browser/host.js",
    "./browser/locale/*.json": "./features/browser/locale/*.json",
    "./browser/icon": "./features/browser/icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "host/",
    "features/",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "check": "node --check client.js && node --check index.js && node --check host/features.js && node --check host/http.js && node --check host/session.js && node --check host/git.js && node --check host/redact.js && node --check features/rail/host.js && node --check features/jobs/host.js && node --check features/subagents/host.js && node --check features/environment/host.js && node --check features/environment/route.js && node --check features/environment/facts.js && node --check features/run/host.js && node --check features/git/host.js && node --check features/git/facts.js && node --check features/sizing/host.js && node --check features/browser/host.js && node --check features/browser/core.js && node scripts/build-client.mjs --check",
    "test": "node --test \"test/*.test.mjs\""
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.2-0 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.3 <4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-terminal-controller"
      ]
    }
  }
}
